// Configuração do deploy no Cloudflare (fluxo Workers com assets estáticos).
// O painel roda `npx wrangler deploy` a cada push e lê este arquivo.
{
  "name": "treinoberna",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
