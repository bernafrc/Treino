// Configuração do deploy no Cloudflare (fluxo Workers com assets estáticos).
// O painel roda `npx wrangler deploy` a cada push e lê este arquivo.
{
  "name": "treinoberna",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Histórico na nuvem: Durable Object com SQLite (funciona no plano grátis).
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "TreinoStore" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TreinoStore"] }
  ]
}
